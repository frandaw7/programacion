import java.util.Scanner;
public class CalcularEstacionamiento {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        float horasSemanales = 0.0;
        float diasSemana = 7.0;
        float horasDiarias = 0.0;
        System.out.printIn("Introduzca la cantidad de horas diarias que acude al estacionamiento. Así conseguirá tener en conocimiento las horas semanales que transcurre en dicha zona.");
        horasDiarias = scanner.nextFloat();
        horasSemanales = horasDiarias * diasSemana;
        System.out.printIn("En la siguiente línea se halla la correspondiente resolución.");
        System.out.printIn(horasSemanales);
    }
}
